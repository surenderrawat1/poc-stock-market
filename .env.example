# Local development placeholders only. Replace both passwords before startup.
# Keep MYSQL_PASSWORD URL-safe because DATABASE_URL uses it without URL encoding.
MYSQL_DATABASE=stock_market
MYSQL_USER=stock_app
MYSQL_PASSWORD=replace-this-local-password
MYSQL_ROOT_PASSWORD=replace-this-local-root-password

# Used by Prisma commands run from the host.
DATABASE_URL=mysql://stock_app:replace-this-local-password@127.0.0.1:3306/stock_market

# Host bindings are loopback-only in docker-compose.yml.
MYSQL_HOST_PORT=3306
API_HOST_PORT=3000
WEB_HOST_PORT=4200
