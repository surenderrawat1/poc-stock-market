generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProviderStatus {
  OFFICIAL @map("official")
  LICENSED @map("licensed")
  MANUAL   @map("manual")
  DISABLED @map("disabled")

  @@map("provider_status")
}

model DataSource {
  id                 String         @id @default(uuid()) @db.Char(36)
  code               String         @unique @db.VarChar(100)
  name               String         @db.VarChar(255)
  providerType       String         @map("provider_type") @db.VarChar(30)
  officialStatus     ProviderStatus @default(DISABLED) @map("official_status")
  licensingReference String?        @map("licensing_reference") @db.VarChar(2048)
  enabled            Boolean        @default(false)
  termsReviewedAt    DateTime?      @map("terms_reviewed_at") @db.DateTime(3)
  termsReviewedBy    String?        @map("terms_reviewed_by") @db.VarChar(255)
  createdAt          DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("data_sources")
}
